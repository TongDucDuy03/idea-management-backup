# API Make (GET /api/make/realtime) - thêm vào file .env

# Chọn 1 trong 2 cách (hoặc dùng cả hai):
# Cách 1: API Key (khuyến nghị cho Make)
MAKE_API_KEY=dat-vao-key-ban-tao

# Cách 2: Bearer token
# MAKE_BEARER_TOKEN=dat-vao-token-ban-tao

# Base URL phục vụ ảnh (cho API Make realtime: beforeImageUrl/afterImageUrl)
# Ví dụ: https://server-cong-ty.com (không slash cuối)
# PUBLIC_BASE_URL=https://your-domain.com

# Tùy chọn:
# MAKE_RATE_LIMIT_PER_MINUTE=60
# MAKE_NEXT_POLL_SECONDS=10
