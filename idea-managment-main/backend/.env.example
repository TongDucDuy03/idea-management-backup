# =====================================================================
# Mẫu cấu hình backend. Copy thành .env rồi điền giá trị thật.
# KHÔNG commit file .env — nó chứa bí mật.
# =====================================================================

# --- Bắt buộc ---------------------------------------------------------

PORT=5000

# Chuỗi kết nối MongoDB
MONGODB_URI=mongodb://localhost:27017/idea-management

# Phiên đăng nhập dùng cookie HttpOnly; JWT_SECRET cũ không còn được sử dụng.

# --- Tùy chọn ---------------------------------------------------------

# production | development
NODE_ENV=development

# Origin được phép gọi API (nhiều origin ngăn cách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000

# Bắt buộc HTTPS trong production; không lấy URL từ Host của client.
# PUBLIC_ASSET_BASE_URL=https://idea.example.com

# Thư mục lưu upload (mặc định: backend/uploads)
# UPLOAD_DIR=/var/www/idea/uploads

# Thời hạn phiên đăng nhập (giây), từ 300 đến 86400; mặc định 8 giờ.
SESSION_TTL_SECONDS=28800

# Production: cùng origin HTTPS cho frontend, /api và /uploads.
# FRONTEND_URL=https://idea.example.com
# Chỉ tin reverse proxy thực tế; không đặt true hoặc số hop tùy ý.
TRUST_PROXY=loopback
BIND_HOST=127.0.0.1

# MongoDB chia sẻ bộ đếm giữa các worker. Mặc định mongo ở production,
# memory ở development; dùng mongo để kiểm thử khả năng chạy nhiều worker.
# RATE_LIMIT_STORE=mongo

# Chỉ dùng khi chạy CLI create-admin, không có mật khẩu mặc định.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Trợ lý AI --------------------------------------------------------
# Dùng OpenRouter (khuyến nghị, key hiện tại của dự án)
OPENROUTER_API_KEY=
# Hoặc dùng thẳng OpenAI
# OPENAI_API_KEY=
# Ghi đè model / endpoint nếu cần
# AI_MODEL=openai/gpt-4o-mini
# AI_API_URL=

# --- Tích hợp Make.com ------------------------------------------------
MAKE_API_KEY=
# MAKE_BEARER_TOKEN=
# MAKE_RATE_LIMIT_PER_MINUTE=60
# MAKE_NEXT_POLL_SECONDS=10

# --- Giới hạn tần suất ------------------------------------------------
# Số lượt gửi ý tưởng tối đa mỗi giờ cho một IP
# IDEA_SUBMIT_LIMIT_PER_HOUR=20
# Số lượt gọi trợ lý AI tối đa mỗi phút cho một IP
# AI_RATE_LIMIT_PER_MINUTE=10
