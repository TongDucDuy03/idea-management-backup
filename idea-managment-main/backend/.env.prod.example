PORT=5000
MONGODB_URI=mongodb://admin:admin123@127.0.0.1:27017/idea-management?authSource=admin
NODE_ENV=production

# Base URL ảnh cho Make trên server (dùng HTTPS)
PUBLIC_ASSET_BASE_URL=https://idea.ducthangloi.com

# Thư mục lưu upload (tuỳ chọn, nếu khác /var/www/idea/uploads)
# UPLOAD_DIR=/var/www/idea/uploads

# API key cho Make trên production
MAKE_API_KEY=my-secret-key-prod

